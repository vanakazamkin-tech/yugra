import React, { useState } from 'react';
import data from '../data/municipalities-detailed.json';

export const InvestmentDetails = () => {
  const [searchTerm, setSearchTerm] = useState('');
  const [selectedGroup, setSelectedGroup] = useState('ALL');
  const [selectedId, setSelectedId] = useState(data.municipalities[0].id);

  // Фильтрация по группе и поисковому запросу
  const filteredMunicipalities = data.municipalities.filter((m) => {
    const matchesGroup = selectedGroup === 'ALL' || m.group2024 === selectedGroup;
    const matchesSearch = m.name.toLowerCase().includes(searchTerm.toLowerCase());
    return matchesGroup && matchesSearch;
  });

  const currentItem = data.municipalities.find((m) => m.id === selectedId) || data.municipalities[0];

  return (
    <div className="bg-slate-50 min-h-screen p-4 md:p-8 font-sans text-slate-900">
      <div className="max-w-5xl mx-auto bg-white p-6 rounded-2xl shadow-sm border border-slate-200 mb-6">
        <h1 className="text-2xl font-black text-slate-900 mb-2">
          Инвестиционный портал Югры 2024
        </h1>
        <p className="text-sm text-slate-500 mb-6">
          Выберите муниципалитет для просмотра детальных показателей инвестиционного климата
        </p>

        {/* Удобный поиск и фильтры групп */}
        <div className="flex flex-col md:flex-row gap-4 mb-6">
          <div className="relative flex-1">
            <input
              type="text"
              placeholder="🔍 Быстрый поиск муниципалитета (например, Сургут, Урай...)"
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="w-full pl-4 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
          <div className="flex gap-1 bg-slate-100 p-1 rounded-xl self-start">
            <button
              onClick={() => setSelectedGroup('ALL')}
              className={`px-3 py-2 text-xs font-bold rounded-lg transition-all ${
                selectedGroup === 'ALL' ? 'bg-white text-blue-600 shadow-sm' : 'text-slate-600'
              }`}
            >
              Все
            </button>
            <button
              onClick={() => setSelectedGroup('A')}
              className={`px-3 py-2 text-xs font-bold rounded-lg transition-all ${
                selectedGroup === 'A' ? 'bg-white text-emerald-600 shadow-sm' : 'text-slate-600'
              }`}
            >
              Группа А
            </button>
            <button
              onClick={() => setSelectedGroup('B')}
              className={`px-3 py-2 text-xs font-bold rounded-lg transition-all ${
                selectedGroup === 'B' ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-600'
              }`}
            >
              Группа B
            </button>
          </div>
        </div>

        {/* Быстрые кнопки-чипсы для переключения между муниципалитетами без неудобных селектов */}
        <div className="flex flex-wrap gap-2 max-h-40 overflow-y-auto p-1 border-t border-slate-100 pt-4">
          {filteredMunicipalities.length > 0 ? (
            filteredMunicipalities.map((m) => (
              <button
                key={m.id}
                onClick={() => setSelectedId(m.id)}
                className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${
                  selectedId === m.id
                    ? 'bg-blue-600 text-white shadow-md'
                    : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                }`}
              >
                #{m.rank2024} {m.name}
              </button>
            ))
          ) : (
            <p className="text-xs text-slate-400 py-2">Муниципалитеты не найдены</p>
          )}
        </div>
      </div>

      {/* Карточка детальной информации выбранного региона */}
      <div className="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <div className="flex justify-between items-center mb-3">
            <span className="text-3xl font-extrabold text-blue-600">#{currentItem.rank2024}</span>
            <span className="px-3 py-1 bg-slate-100 text-slate-700 text-xs font-bold rounded-full">
              Группа {currentItem.group2024}
            </span>
          </div>
          <h2 className="text-xl font-bold text-slate-800">{currentItem.name}</h2>
          <div className="mt-4 pt-4 border-t border-slate-100">
            <p className="text-xs text-slate-400 font-bold uppercase">Рейтинговый балл</p>
            <p className="text-3xl font-black text-slate-900 mt-1">{currentItem.score}</p>
          </div>
        </div>

        <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <h3 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4">
            Инвестиционная активность
          </h3>
          <div className="space-y-4">
            <div>
              <p className="text-xs text-slate-400">Объем инвестиций (без добычи)</p>
              <p className="text-xl font-bold text-slate-800">
                {currentItem.investments.volumeBillion} млрд руб.
              </p>
            </div>
            <div>
              <p className="text-xs text-slate-400">Динамика роста</p>
              <p className="text-lg font-extrabold text-emerald-600">
                {currentItem.investments.growthPercent}%
              </p>
            </div>
          </div>
        </div>

        <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <h3 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4">
            Малый и средний бизнес (МСП)
          </h3>
          <div className="space-y-4">
            <div>
              <p className="text-xs text-slate-400">Субъекты МСП</p>
              <p className="text-xl font-bold text-slate-800">
                {currentItem.smeCount.toLocaleString()} ед.
              </p>
            </div>
            <div>
              <p className="text-xs text-slate-400">Оценка климата бизнесом</p>
              <p className="text-lg font-extrabold text-blue-600">
                {currentItem.assessmentScore} / 5.00
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default InvestmentDetails;